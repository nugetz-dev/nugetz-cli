<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nugetz</ToolCommandName>
    <PackageId>Nugetz.Cli</PackageId>
    <Version>0.4.0</Version>
    <Authors>Authaz</Authors>
    <Description>Repository-aware NuGet audits, upgrade plans, package validation, search, installation, and safer publishing for .NET teams.</Description>
    <PackageProjectUrl>https://nugetz.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nugetz-dev/nugetz-cli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/nugetz-dev/nugetz-cli/releases</PackageReleaseNotes>
    <PackageTags>nuget;cli;dotnet;packages;audit;upgrade;dependencies;security;publish</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Nugetz.Cli.Tests/**/*.cs" />
    <None Remove="Nugetz.Cli.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

</Project>
